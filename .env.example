# Copy this file to .env (or set the variables in your shell) and edit the values.
# .env is git-ignored, so real passwords never reach GitHub.

# ---- Database -------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=car_service_db

# Set to 1 for managed MySQL that requires TLS (Aiven, TiDB Cloud, ...)
DB_SSL=0
# Set to 1 only if you have a CA certificate configured for the server
DB_SSL_VERIFY=0

# ---- Flask ----------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
FLASK_DEBUG=0
